# ====================================================
# Citation Binder Server Configuration
# ====================================================

HOST=127.0.0.1
PORT=8080
DEBUG=false

# ----------------------------------------------------
# Security & Retrieval Boundaries
# ----------------------------------------------------
MAX_REDIRECTS=5
MAX_BODY_BYTES=2097152    # 2 MB response size cap
FETCH_TIMEOUT=8.0         # 8 seconds total request timeout
TOP_K_PASSAGES=4
MIN_RELEVANCE_SCORE=0.5

# ----------------------------------------------------
# Model Provider & Server-Side Credentials
# ----------------------------------------------------
# Supported Providers: "gemini", "openai", "heuristic"
LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Offline Fallback Setting:
# If false (default), missing credentials return a setup notice.
# If true, uses the built-in deterministic NLI heuristic engine when keys are absent.
ALLOW_HEURISTIC_FALLBACK=true
